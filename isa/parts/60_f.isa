flw %d(freg), %i:S12(immediate) (%a(reg))
%i[11:0] %a[4:0] 010 %d[4:0] 0000111
# [F] rd = mem32[rs1 + imm] (NaN-boxed if 32-bit)

fsw %b(freg), %i:S12(immediate) (%a(reg))
%i[11:5] %b[4:0] %a[4:0] 010 %i[4:0] 0100111
# [F] mem32[rs1 + imm] = rs2

fmadd.s %d(freg), %a(freg), %b(freg), %c(freg), %r(rm)
%c[4:0] 00 %b[4:0] %a[4:0] %r[2:0] %d[4:0] 1000011
# [F] rd = rs1 * rs2 + rs3

