0000000 %b[4:0] %a[4:0] 111 %d[4:0] 1010011
# [F] rd = rs1 + rs2

fsub.s %d(freg), %a(freg), %b(freg), %r(rm)
0000100 %b[4:0] %a[4:0] %r[2:0] %d[4:0] 1010011
# [F] rd = rs1 - rs2

fsub.s %d(freg), %a(freg), %b(freg)
0000100 %b[4:0] %a[4:0] 111 %d[4:0] 1010011
# [F] rd = rs1 - rs2

fmul.s %d(freg), %a(freg), %b(freg), %r(rm)
0001000 %b[4:0] %a[4:0] %r[2:0] %d[4:0] 1010011
# [F] rd = rs1 * rs2

fmul.s %d(freg), %a(freg), %b(freg)
0001000 %b[4:0] %a[4:0] 111 %d[4:0] 1010011
# [F] rd = rs1 * rs2

fdiv.s %d(freg), %a(freg), %b(freg), %r(rm)
0001100 %b[4:0] %a[4:0] %r[2:0] %d[4:0] 1010011
# [F] rd = rs1 / rs2

fdiv.s %d(freg), %a(freg), %b(freg)
0001100 %b[4:0] %a[4:0] 111 %d[4:0] 1010011
# [F] rd = rs1 / rs2

fsqrt.s %d(freg), %a(freg), %r(rm)
0101100 00000 %a[4:0] %r[2:0] %d[4:0] 1010011
# [F] rd = sqrt(rs1)

fsqrt.s %d(freg), %a(freg)
0101100 00000 %a[4:0] 111 %d[4:0] 1010011
# [F] rd = sqrt(rs1)

fsgnj.s %d(freg), %a(freg), %b(freg)
0010000 %b[4:0] %a[4:0] 000 %d[4:0] 1010011
# [F] rd = |rs1| with sign of rs2

fsgnjn.s %d(freg), %a(freg), %b(freg)
0010000 %b[4:0] %a[4:0] 001 %d[4:0] 1010011
# [F] rd = |rs1| with inverted sign of rs2

fsgnjx.s %d(freg), %a(freg), %b(freg)
0010000 %b[4:0] %a[4:0] 010 %d[4:0] 1010011
# [F] rd = rs1 with sign = sign(rs1) xor sign(rs2)

fmin.s %d(freg), %a(freg), %b(freg)
0010100 %b[4:0] %a[4:0] 000 %d[4:0] 1010011
# [F] rd = min(rs1, rs2)

fmax.s %d(freg), %a(freg), %b(freg)
