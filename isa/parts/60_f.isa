fcvt.s.lu %d(freg), %a(reg)
1101000 00011 %a[4:0] 111 %d[4:0] 1010011
# [F] rd = float(uint64(rs1))

feq.s %d(reg), %a(freg), %b(freg)
1010000 %b[4:0] %a[4:0] 010 %d[4:0] 1010011
# [F] rd = (rs1 == rs2)

flt.s %d(reg), %a(freg), %b(freg)
1010000 %b[4:0] %a[4:0] 001 %d[4:0] 1010011
# [F] rd = (rs1 < rs2)

fle.s %d(reg), %a(freg), %b(freg)
1010000 %b[4:0] %a[4:0] 000 %d[4:0] 1010011
# [F] rd = (rs1 <= rs2)

fclass.s %d(reg), %a(freg)
1110000 00000 %a[4:0] 001 %d[4:0] 1010011
