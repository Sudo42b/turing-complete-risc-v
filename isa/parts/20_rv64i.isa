sd %b(reg), %i:S12(immediate) (%a(reg))
%i[11:5] %b[4:0] %a[4:0] 011 %i[4:0] 0100011
# [I] mem64[rs1 + imm] = rs2

addi %d(reg), %a(reg), %i:S12(immediate)
%i[11:0] %a[4:0] 000 %d[4:0] 0010011
# [I] rd = rs1 + imm

slti %d(reg), %a(reg), %i:S12(immediate)
%i[11:0] %a[4:0] 010 %d[4:0] 0010011
# [I] rd = (rs1 < imm) signed

sltiu %d(reg), %a(reg), %i:S12(immediate)
