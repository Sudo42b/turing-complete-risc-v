# [I] rd = sext(mem32[rs1 + imm])

ld %d(reg), %i:S12(immediate) (%a(reg))
%i[11:0] %a[4:0] 011 %d[4:0] 0000011
# [I] rd = mem64[rs1 + imm]

lbu %d(reg), %i:S12(immediate) (%a(reg))
%i[11:0] %a[4:0] 100 %d[4:0] 0000011
