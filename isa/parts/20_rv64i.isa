or %d(reg), %a(reg), %b(reg)
0000000 %b[4:0] %a[4:0] 110 %d[4:0] 0110011
# [I] rd = rs1 | rs2

and %d(reg), %a(reg), %b(reg)
0000000 %b[4:0] %a[4:0] 111 %d[4:0] 0110011
# [I] rd = rs1 & rs2

addiw %d(reg), %a(reg), %i:S12(immediate)
%i[11:0] %a[4:0] 000 %d[4:0] 0011011
# [I] rd = sext32(rs1 + imm)

slliw %d(reg), %a(reg), %s:U5(immediate)
0000000 %s[4:0] %a[4:0] 001 %d[4:0] 0011011
