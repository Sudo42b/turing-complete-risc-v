0000000 %b[4:0] %a[4:0] 100 %d[4:0] 0110011
# [I] rd = rs1 ^ rs2

srl %d(reg), %a(reg), %b(reg)
0000000 %b[4:0] %a[4:0] 101 %d[4:0] 0110011
# [I] rd = rs1 >> rs2[5:0] (logical)

sra %d(reg), %a(reg), %b(reg)
0100000 %b[4:0] %a[4:0] 101 %d[4:0] 0110011
