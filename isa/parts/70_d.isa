%c[4:0] 01 %b[4:0] %a[4:0] 111 %d[4:0] 1001111
# [D] rd = -(rs1 * rs2) - rs3

fadd.d %d(freg), %a(freg), %b(freg), %r(rm)
0000001 %b[4:0] %a[4:0] %r[2:0] %d[4:0] 1010011
# [D] rd = rs1 + rs2

fadd.d %d(freg), %a(freg), %b(freg)
0000001 %b[4:0] %a[4:0] 111 %d[4:0] 1010011
# [D] rd = rs1 + rs2

fsub.d %d(freg), %a(freg), %b(freg), %r(rm)
0000101 %b[4:0] %a[4:0] %r[2:0] %d[4:0] 1010011
# [D] rd = rs1 - rs2

fsub.d %d(freg), %a(freg), %b(freg)
0000101 %b[4:0] %a[4:0] 111 %d[4:0] 1010011
# [D] rd = rs1 - rs2

fmul.d %d(freg), %a(freg), %b(freg), %r(rm)
0001001 %b[4:0] %a[4:0] %r[2:0] %d[4:0] 1010011
# [D] rd = rs1 * rs2

fmul.d %d(freg), %a(freg), %b(freg)
0001001 %b[4:0] %a[4:0] 111 %d[4:0] 1010011
# [D] rd = rs1 * rs2

fdiv.d %d(freg), %a(freg), %b(freg), %r(rm)
0001101 %b[4:0] %a[4:0] %r[2:0] %d[4:0] 1010011
# [D] rd = rs1 / rs2

fdiv.d %d(freg), %a(freg), %b(freg)
0001101 %b[4:0] %a[4:0] 111 %d[4:0] 1010011
# [D] rd = rs1 / rs2

fsqrt.d %d(freg), %a(freg), %r(rm)
0101101 00000 %a[4:0] %r[2:0] %d[4:0] 1010011
# [D] rd = sqrt(rs1)

fsqrt.d %d(freg), %a(freg)
0101101 00000 %a[4:0] 111 %d[4:0] 1010011
# [D] rd = sqrt(rs1)

fsgnj.d %d(freg), %a(freg), %b(freg)
0010001 %b[4:0] %a[4:0] 000 %d[4:0] 1010011
# [D] rd = |rs1| with sign of rs2

fsgnjn.d %d(freg), %a(freg), %b(freg)
0010001 %b[4:0] %a[4:0] 001 %d[4:0] 1010011
# [D] rd = |rs1| with inverted sign of rs2

fsgnjx.d %d(freg), %a(freg), %b(freg)
0010001 %b[4:0] %a[4:0] 010 %d[4:0] 1010011
# [D] rd = rs1 with sign = sign(rs1) xor sign(rs2)

fmin.d %d(freg), %a(freg), %b(freg)
0010101 %b[4:0] %a[4:0] 000 %d[4:0] 1010011
# [D] rd = min(rs1, rs2)

fmax.d %d(freg), %a(freg), %b(freg)
0010101 %b[4:0] %a[4:0] 001 %d[4:0] 1010011
# [D] rd = max(rs1, rs2)

fcvt.w.d %d(reg), %a(freg), %r(rm)
1100001 00000 %a[4:0] %r[2:0] %d[4:0] 1010011
# [D] rd = int32(rs1) sign-extended

fcvt.w.d %d(reg), %a(freg)
1100001 00000 %a[4:0] 111 %d[4:0] 1010011
