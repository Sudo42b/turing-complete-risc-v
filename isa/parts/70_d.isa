fld %d(freg), %i:S12(immediate) (%a(reg))
%i[11:0] %a[4:0] 011 %d[4:0] 0000111
# [D] rd = mem64[rs1 + imm] (NaN-boxed if 32-bit)

fsd %b(freg), %i:S12(immediate) (%a(reg))
%i[11:5] %b[4:0] %a[4:0] 011 %i[4:0] 0100111
# [D] mem64[rs1 + imm] = rs2

fmadd.d %d(freg), %a(freg), %b(freg), %c(freg), %r(rm)
%c[4:0] 01 %b[4:0] %a[4:0] %r[2:0] %d[4:0] 1000011
# [D] rd = rs1 * rs2 + rs3

