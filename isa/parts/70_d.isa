fcvt.d.lu %d(freg), %a(reg)
1101001 00011 %a[4:0] 111 %d[4:0] 1010011
# [D] rd = float(uint64(rs1))

feq.d %d(reg), %a(freg), %b(freg)
1010001 %b[4:0] %a[4:0] 010 %d[4:0] 1010011
# [D] rd = (rs1 == rs2)

flt.d %d(reg), %a(freg), %b(freg)
1010001 %b[4:0] %a[4:0] 001 %d[4:0] 1010011
# [D] rd = (rs1 < rs2)

fle.d %d(reg), %a(freg), %b(freg)
1010001 %b[4:0] %a[4:0] 000 %d[4:0] 1010011
# [D] rd = (rs1 <= rs2)

fclass.d %d(reg), %a(freg)
1110001 00000 %a[4:0] 001 %d[4:0] 1010011
# [D] rd = classification mask of rs1

fmv.x.d %d(reg), %a(freg)
